parameters:
  level: 9
  treatPhpDocTypesAsCertain: false
  paths:
    - packages
    - modules
  excludePaths:
    - web
    - vendor
    - packages/reflection/src/MethodReflection.php
    # Fixtures with a missing parent or interface cause non-ignorable errors.
    - packages/reflection/tests/src/Fixtures/ClassWithMissing*.php
  ignoreErrors:
    # Assume that iterable value is 'mixed' if not further specified.
    - identifier: missingType.iterableValue
    # Assume that generic type is 'mixed' if not further specified.
    - identifier: argument.templateType
    # Assume that generic type is 'mixed' if not further specified.
    - identifier: missingType.generics
    # Don't force Drupal Yaml in packages.
    - identifier: drupal.symfonyYamlParse
