{
    "name": "ock/drupal-testing",
    "license": "MIT",
    "authors": [
        {
            "name": "Andreas Hennings",
            "email": "andreas@dqxtech.net"
        }
    ],
    "minimum-stability": "dev",
    "prefer-stable": true,
    "autoload": {
        "psr-4": {
            "Ock\\DrupalTesting\\": "src"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Ock\\DrupalTesting\\Tests\\": "tests/src"
        }
    },
    "require": {
        "php": ">=8.3",
        "ext-json": "*",
        "drupal/core": "^11.4.9",
        "drupal/core-dev": "^11.4.9",
        "ock/testing": "self.version",
        "phpunit/phpunit": "^11.5"
    },
    "require-dev": {
        "composer/installers": "^2.3.0",
        "drupal/core-composer-scaffold": "^11.4.9"
    },
    "config": {
        "allow-plugins": {
            "composer/installers": true,
            "dealerdirect/phpcodesniffer-composer-installer": true,
            "drupal/core-composer-scaffold": true,
            "php-http/discovery": true,
            "phpstan/extension-installer": true,
            "symfony/runtime": true,
            "tbachert/spi": false
        }
    },
    "extra": {
        "drupal-scaffold": {
            "locations": {
                "web-root": "web/"
            }
        },
        "installer-paths": {
            "web/core": [
                "type:drupal-core"
            ]
        },
        "phpstan/extension-installer": {
            "ignore": [
                "mglaman/phpstan-drupal"
            ]
        }
    }
}
